{
  "name": "@2k27/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./src/*": "./src/*"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:validate": "tsx src/cli/validate.ts",
    "data:report": "tsx src/cli/report.ts",
    "data:crosscheck": "tsx src/cli/crosscheck.ts"
  },
  "dependencies": {
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "tsx": "^4.20.3",
    "vitest": "^3.2.4"
  }
}